<?xml version="1.0"?>
<!--
  reauth-bot — standalone Schwab trusted-device re-consent bot (its own repo:
  github.com/texasdaddy/reauth-bot). Self-contained image built by that repo's CI → GHCR:
  deploys the Unraid way — UI import → set IP + variables → Apply. One-time interactive seed is
  a SEED_MODE variable toggle (no docker-run, no mounted script). This template deploys it for
  Tape (LOGIN_URL/TOKEN_URL default to tape-dev). Full runbook: reauth-bot repo README.
-->
<Container version="2">
  <Name>reauth-bot</Name>
  <Repository>ghcr.io/texasdaddy/reauth-bot:latest</Repository>
  <Registry>https://github.com/texasdaddy/reauth-bot/pkgs/container/reauth-bot</Registry>
  <Network>bridge</Network>                                           <!-- neutral default; the bot is outbound-only. Pick br0 + a fixed IP in the UI if you prefer. -->
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/texasdaddy/reauth-bot</Project>
  <Overview>Standalone Schwab trusted-device re-consent bot (repo: github.com/texasdaddy/reauth-bot). Self-contained image; on a ~72h cadence it drives a target service's login flow inside a persistent trusted-device profile (skips 2FA) so the Schwab 7-day consent refreshes itself. This template targets Tape (LOGIN_URL/TOKEN_URL default to tape-dev). REQUIRES a one-time interactive trusted-device seed: set SEED_MODE=1 + SEED_VNC_PASSWORD, Apply, complete the consent over noVNC (http://CONTAINER-IP:6080/vnc.html), then clear SEED_MODE and Apply. The trusted-device cookie MUST persist across updates (Profile volume). See the reauth-bot repo README.</Overview>
  <Category>Network:Other</Category>
  <WebUI/>                                                            <!-- steady state has no web UI; seed noVNC is at http://CONTAINER-IP:6080/vnc.html only while SEED_MODE=1 -->
  <TemplateURL>https://raw.githubusercontent.com/texasdaddy/unraid-templates/main/templates/reauth-bot.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/texasdaddy/unraid-templates/main/icons/reauth_bot.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <DateInstalled/>
  <Description>Standalone Schwab trusted-device re-consent bot (github.com/texasdaddy/reauth-bot). Self-contained image; UI-deployed; one-time seed via SEED_MODE. This template targets Tape.</Description>

  <!-- Trusted-device profile MUST persist across container updates (losing it forces a manual re-seed). -->
  <Config Name="Profile" Target="/profile" Default="/mnt/POOL/appdata/reauth-bot/profile" Mode="rw" Description="Trusted-device browser profile + /profile/shots debug captures (persist across updates; root-only, holds brokerage imagery)" Type="Path" Display="always" Required="true" Mask="false">/mnt/POOL/appdata/reauth-bot/profile</Config>

  <!-- Schwab LOGIN creds (full-account; this container's env is root-only). The bot does NOT
       need the Schwab APP key/secret — those live in the target service, which mints the token. -->
  <Config Name="SCHWAB_USER" Target="SCHWAB_USER" Default="" Mode="" Description="Schwab login id (drives the trusted-device browser login)" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="SCHWAB_PASS" Target="SCHWAB_PASS" Default="" Mode="" Description="Schwab password" Type="Variable" Display="always" Required="true" Mask="true"/>

  <!-- Target service's OWN OAuth endpoints (default: tape-dev; swap host for prod / another service). -->
  <Config Name="LOGIN_URL" Target="LOGIN_URL" Default="https://tape-dev.your-domain.example/v1/admin/login" Mode="" Description="The service's login endpoint the bot navigates to start consent" Type="Variable" Display="always" Required="true" Mask="false">https://tape-dev.your-domain.example/v1/admin/login</Config>
  <Config Name="TOKEN_URL" Target="TOKEN_URL" Default="http://<internal-ip>:8000/v1/admin/token" Mode="" Description="The service's token-status endpoint the bot reads (plain HTTP GET) to confirm the consent advanced. Use a DIRECT/internal URL not behind a CDN — a public CDN (Cloudflare) 403s non-browser requests. For tape: the container IP." Type="Variable" Display="always" Required="true" Mask="false">http://<internal-ip>:8000/v1/admin/token</Config>
  <Config Name="CALLBACK_URL_MATCH" Target="CALLBACK_URL_MATCH" Default="" Mode="" Description="Optional: substring of the post-consent redirect back to the service (blank = image default /v1/admin/callback)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="TOKEN_ISSUED_FIELD" Target="TOKEN_ISSUED_FIELD" Default="" Mode="" Description="Optional: the monotonic consent field in TOKEN_URL's JSON (blank = image default refresh_issued_at)" Type="Variable" Display="advanced" Required="false" Mask="false"/>

  <!-- Alerts + cadence. -->
  <Config Name="REAUTH_NTFY_URL" Target="REAUTH_NTFY_URL" Default="" Mode="" Description="Full ntfy topic URL for success/failure pushes (unset = log-only)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="REAUTH_INTERVAL_HOURS" Target="REAUTH_INTERVAL_HOURS" Default="72" Mode="" Description="Refresh cadence in hours (~3d = 2+ tries per 7-day Schwab window)" Type="Variable" Display="always" Required="false" Mask="false">72</Config>
  <Config Name="REAUTH_RETRY_HOURS" Target="REAUTH_RETRY_HOURS" Default="24" Mode="" Description="Retry interval after a failed run, in hours" Type="Variable" Display="always" Required="false" Mask="false">24</Config>

  <!-- One-time seed (leave BOTH blank for steady state). Set SEED_MODE=1 + a strong
       SEED_VNC_PASSWORD, Apply, do the consent over noVNC, then clear SEED_MODE and Apply. -->
  <Config Name="SEED_MODE" Target="SEED_MODE" Default="" Mode="" Description="Set to 1 ONLY for the one-time interactive seed (headed browser over noVNC on :6080); blank = headless steady state" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="SEED_VNC_PASSWORD" Target="SEED_VNC_PASSWORD" Default="" Mode="" Description="Required when SEED_MODE=1 — VNC password gating noVNC (the seed is a live brokerage login on br0). Blank refuses to start in seed mode." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="REAUTH_SEED_HOLD_SECONDS" Target="REAUTH_SEED_HOLD_SECONDS" Default="900" Mode="" Description="How long (s) the seed keeps the headed browser open for you to log in + approve 2FA. Raise if a slow SMS 2FA risks closing it mid-login." Type="Variable" Display="advanced" Required="false" Mask="false">900</Config>
  <Config Name="Seed noVNC" Target="6080" Default="6080" Mode="tcp" Description="noVNC port, used ONLY during the seed (SEED_MODE=1). Reach it at http://SERVER-OR-CONTAINER-IP:6080/vnc.html (on bridge it's the host IP; on br0 the container IP)." Type="Port" Display="advanced" Required="false" Mask="false">6080</Config>

  <!-- Schwab page selectors — override ONLY if the in-script defaults don't match the live pages
       (confirm during the seed). Left blank = use the image defaults. -->
  <Config Name="SEL_USER" Target="SEL_USER" Default="" Mode="" Description="Optional: username field CSS selector (blank = default #loginIdInput)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="SEL_PASS" Target="SEL_PASS" Default="" Mode="" Description="Optional: password field selector (blank = #passwordInput)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="SEL_SUBMIT" Target="SEL_SUBMIT" Default="" Mode="" Description="Optional: submit button selector (blank = #btnLogin)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="SEL_CONSENT" Target="SEL_CONSENT" Default="" Mode="" Description="Optional: consent/allow button selector list (blank = image default)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="SEL_2FA" Target="SEL_2FA" Default="" Mode="" Description="Optional: selector(s) detecting a re-appeared 2FA prompt (blank = image default). Gates the 're-seed required' alarm." Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
