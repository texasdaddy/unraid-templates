#!/bin/sh
# Blocks a PUSH that would publish internal identifying information in ANY commit being sent.
#
# The pre-commit hook and CI both scan the working TREE, which answers "is the leak here now".
# A push publishes HISTORY, and the tree scan has two blind spots this closes:
#
#   1. A codename committed and then deleted is absent from the tree, passes every tree scan,
#      and is still permanently readable at the commit that added it once the branch reaches
#      the remote.
#   2. A brand-new file is not in `git ls-files` until it is staged, so a tree scan run before
#      `git add` reports "no internal info found" on a tree that does not contain it. That is
#      how a synthetic internal hostname reached a public remote. The range scan reads what
#      each COMMIT added, so a new file's first commit is exactly what it looks at.
#
# Both are the expensive case — recovering costs a history rewrite and a force-push across
# every clone — so it is worth catching one step earlier, before the bytes leave the machine.
#
# Opt in per clone (one time):   git config core.hooksPath .githooks
# CI runs the same range scan on every PR, so this is a convenience, not the enforcement point.
#
# git feeds us one line per ref being pushed:  <local_ref> <local_sha> <remote_ref> <remote_sha>
# NOT `command -v python3`: on Windows that finds the Microsoft Store App Execution Alias stub,
# which then aborts the push with "Python was not found" and no mention of this guard. Probing
# with a real invocation picks the interpreter that actually runs.
if python3 -c "" >/dev/null 2>&1; then PY=python3; else PY=python; fi
z40="0000000000000000000000000000000000000000"
status=0
# git passes the remote's NAME as $1 and its URL as $2 (both the URL when the push names one).
remote_name="${1:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
    # A branch DELETION pushes the null sha as the local side. Nothing is being published.
    [ "$local_sha" = "$z40" ] && continue
    # ⚠️ `$remote_ref` DECIDES WHETHER THIS IS A TAG PUSH — it is what lands on the remote, and a
    # refspec may rename (`git push origin clean:refs/tags/v1`). The RANGE is still built from
    # `$local_ref`, because that is what names an object in THIS clone.
    #
    # ⛔ THE NAME IS NOT SCANNED AS A NAME, and that is a deliberate revert — see issue #49. A
    # version of this passed both names to the guard so a leaking ref NAME could not be published
    # under a clean local one; it produced a production bypass in three consecutive verification
    # rounds and was withdrawn as beyond this package's scope.
    #
    # ⚠️ AN ANNOTATED TAG'S NAME IS STILL READ — INCIDENTALLY. `git cat-file tag` emits a
    # `tag <name>` header inside the object, and the guard scans the whole object, so an annotated
    # tag called after a host IS caught. What is unread is a name with no object behind it: a
    # LIGHTWEIGHT tag, or a BRANCH. #49 carries the repros.
    # ⭐ "NOT ALREADY PUBLISHED" MEANS NOT ON THE REMOTE BEING PUSHED TO, not on ANY remote
    # (issue #47). `--not --remotes` excludes every remote-tracking ref, so with a second remote
    # a commit already on `private/main` was skipped when pushed to `public` — a remote that had
    # never seen it — and the leak landed there with the guard printing "0 commit(s)". git hands
    # this hook the remote NAME as $1 (or its URL, when the push names one directly); when it is
    # a name, the exclusion is narrowed to that remote's own refs. A URL keeps the wide form,
    # which is the fail-open case this cannot fix but at least does not widen.
    case "$remote_name" in
        ''|*[!A-Za-z0-9._/-]*) not_pushed="--not --remotes" ;;
        *)                     not_pushed="--not --remotes=$remote_name" ;;
    esac
    case "$remote_ref" in
        refs/tags/*)
            # ⭐ A TAG PUSH IS SCANNED BY REF, NOT BY WHAT ITS COMMIT REACHES, and the difference
            # is the whole reason this branch exists. Cutting a tag at an already-pushed commit is
            # the ordinary release gesture, and there `<sha> --not --remotes` resolves to ZERO
            # commits — so the tag's own object, tagger and message reached the remote with the
            # guard printing "no internal info added across 0 commit(s)" and exiting 0. Passing the
            # LOCAL ref name in the range is what puts the tag OBJECT in front of the guard.
            range="$local_ref $not_pushed"
            ;;
        *)
            if [ "$remote_sha" = "$z40" ]; then
                # A brand-new branch: there is no remote counterpart to diff against, so scan every
                # commit on it that is not already on some other remote-tracking ref. Without this a
                # first push — the most likely moment for a leak — would scan zero commits.
                range="$local_sha $not_pushed"
            else
                range="$remote_sha..$local_sha"
            fi
            # ⚠️ A BRANCH PUSH SENDS NO TAGS (only --tags / --follow-tags do), and the range names
            # none, so the guard scans none. That is deliberate: scanning every local tag here
            # blocked ordinary branch pushes on a private `wip` tag that was never being sent.
            ;;
    esac
    "$PY" scripts/check_no_internal_info.py --range "$range" || status=1
done

exit "$status"
